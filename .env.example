# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
# Provide your Supabase project URL and public Anon key for database storage (RSVPs, member routines, and messages).
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Optional Admin Configuration
# Comma-separated list of admin emails authorized to access the private /mbh-admin portal.
# Users must first exist in Supabase Auth (e.g. created via Supabase Auth Dashboard).
VITE_ADMIN_EMAILS=""

# Cloudinary Configuration for Image & Media Hosting
# Create Unsigned Upload Presets in Cloudinary Console (Settings -> Upload -> Add upload preset -> Signing Mode: Unsigned)
# Note: Media routes to dedicated folders and unsigned presets.
VITE_CLOUDINARY_CLOUD_NAME=""
# Dedicated unsigned upload preset for member photos (images) -> mumbai-beatbox-hub/members/photos
VITE_CLOUDINARY_PHOTO_PRESET="mbh_member_photos"
# Dedicated unsigned upload preset for member voice-notes (audio/video formats) -> mumbai-beatbox-hub/members/voice-notes
VITE_CLOUDINARY_AUDIO_PRESET="mbh_member_audio"
# Dedicated unsigned upload preset for visual gallery photos (images) -> mumbai-beatbox-hub/gallery
VITE_CLOUDINARY_GALLERY_PRESET="mbh_gallery_images"
# Dedicated unsigned upload preset for featured videos (video files) -> mumbai-beatbox-hub/videos
VITE_CLOUDINARY_VIDEO_PRESET="mbh_featured_videos"
# Dedicated unsigned upload preset for featured video thumbnails (images) -> mumbai-beatbox-hub/videos/thumbnails
VITE_CLOUDINARY_VIDEO_THUMBNAIL_PRESET="mbh_video_thumbnails"
# Fallback upload preset and folder
VITE_CLOUDINARY_UPLOAD_PRESET="mbh_unsigned"
VITE_CLOUDINARY_FOLDER="mbh_media"
